        <!-- Global Modern Studio Dark CheckBox Style (Replaces default white Windows square box) -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                            <Border x:Name="CheckBoxBorder"
                                    Width="15"
                                    Height="15"
                                    CornerRadius="4"
                                    Background="#15151A"
                                    BorderBrush="#363644"
                                    BorderThickness="1.2"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 2.5,6.5 L 5.5,9.5 L 11.5,3.5"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#525266"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#1D1D24"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#E11D48"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#FB7185"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Studio Dark Pill Toggle CheckBox Style (For Subfolders & Auto Preview) -->
        <Style x:Key="StudioPillCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Background" Value="#17171D"/>
            <Setter Property="BorderBrush" Value="#272732"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CheckIndicator"
                                        Width="14"
                                        Height="14"
                                        CornerRadius="3.5"
                                        Background="#101014"
                                        BorderBrush="#383846"
                                        BorderThickness="1.2"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
                                          Data="M 2.2,6.2 L 5.0,9.0 L 10.8,3.2"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#202028"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#3A3A4A"/>
                                <Setter TargetName="CheckIndicator" Property="BorderBrush" Value="#525268"/>
                                <Setter Property="Foreground" Value="#F4F4F5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#221419"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#6B1D2F"/>
                                <Setter TargetName="CheckIndicator" Property="Background" Value="#E11D48"/>
                                <Setter TargetName="CheckIndicator" Property="BorderBrush" Value="#FB7185"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PillBorder" Property="Background" Value="#2B171E"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#9F1239"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Mini Toolbar Button Style (Modern Studio Dark) -->
        <Style x:Key="SidebarToolbarButtonStyle" TargetType="Button">
