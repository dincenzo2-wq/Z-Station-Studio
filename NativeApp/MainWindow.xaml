        <!-- Modern Studio Toolbar Chip Button Style -->
        <Style x:Key="StudioToolbarChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#17171D"/>
            <Setter Property="BorderBrush" Value="#272732"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
