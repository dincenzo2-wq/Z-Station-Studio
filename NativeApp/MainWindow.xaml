<Window x:Class="ZStationStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:controls="clr-namespace:ZStationStudio.Controls"
        mc:Ignorable="d"
        Title="Z-Station Studio" Height="800" Width="1140"
        Icon="app.ico"
        MinWidth="880" MinHeight="620"
        Background="#141414"
        Foreground="#FFFFFF"
        FontFamily="pack://application:,,,/Fonts/#Quicksand, ./Fonts/#Quicksand, Quicksand, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        AllowDrop="True"
        Drop="MainWindow_Drop"
        DragOver="MainWindow_DragOver"
        DragLeave="MainWindow_DragLeave">

    <Window.Resources>
        <sys:Double x:Key="ThumbnailCardWidth">240</sys:Double>
        <sys:Double x:Key="ThumbnailCardImageHeight">135</sys:Double>

        <!-- Netflix Design Tokens (Theater Black #141414, Surface #1F1F1F, Signature Red #E50914) -->
        <SolidColorBrush x:Key="BgNeutral" Color="#141414"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="#262626"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="BorderMedium" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B3B3B3"/>
        <SolidColorBrush x:Key="NetflixRed" Color="#E50914"/>
        <SolidColorBrush x:Key="NetflixRedHover" Color="#F40612"/>

