        <!-- TreeView Expand/Collapse Arrow Style -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="Transparent" Width="20" Height="20">
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="#737373"
                                  Data="M 2 1 L 7 6 L 2 11 Z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 1 2 L 11 2 L 6 7 Z"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TreeViewItem Style -->
        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="2"
                                    MinHeight="26">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Style="{StaticResource ExpandCollapseToggleStyle}"
                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                    <ContentPresenter Grid.Column="1" x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter Grid.Row="1" x:Name="ItemsHost" Margin="14,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Collapsed state hides ItemsHost! -->
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D3D3D"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="false"/>
                                    <Condition Property="IsMouseOver" Value="true" SourceName="Bd"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E1E"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Search -->
            <RowDefinition Height="Auto"/> <!-- Tag Chips -->
            <RowDefinition Height="*"/>    <!-- Main Body: Sidebar & Results -->
            <RowDefinition Height="Auto"/> <!-- Bottom Player & Waveform -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER & SEARCH BAR (Cinema Black Foundation #1F1F1F / #141414) -->
        <Border Grid.Row="0" Background="#1F1F1F" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- App Title -->
                    <ColumnDefinition Width="*"/>    <!-- Search Input -->
                    <ColumnDefinition Width="Auto"/> <!-- Top Action Buttons -->
                </Grid.ColumnDefinitions>

                <!-- App Title: Z-Station Studio branding with original audio wave logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Path Data="{StaticResource IconAudioWave}" Stroke="#E50914" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Z-Station" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#E50914" CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STUDIO" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>

                <!-- Search Box with sleek vector magnifying glass -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Background="#141414"
                             Foreground="#FFFFFF"
                             CaretBrush="#E50914"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             FontSize="14"
                             Padding="34,7,28,7"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <!-- Search Icon (Lucide Search Vector) -->
                    <Path Data="{StaticResource IconSearch}" Stroke="#737373" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Tìm kiếm: whoosh, tiếng bước chân, cinematic, nhạc nhẹ... (nhấn ESC để xóa)"
                               Foreground="#737373"
                               FontSize="14"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="34,0,0,0"/>
                    <Button x:Name="ClearSearchBtn"
                            Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Padding="6,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B3B3B3"
                            Visibility="Collapsed"
                            Click="ClearSearchBtn_Click"/>
                </Grid>

                <!-- Actions: Update Manager, Cache Manager & Rescan -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="UpdateManageBtn" Margin="0,0,8,0" ToolTip="Kiểm tra &amp; Cập nhật phiên bản mới trực tiếp trong ứng dụng" Click="UpdateManageBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="UpdateBtnIconPath" Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconCloud}" Stroke="#46D369" Width="12" Height="12" Margin="0,0,6,0"/>
                            <TextBlock x:Name="UpdateBtnText" Text="Kiểm tra cập nhật" Foreground="#E5E5E5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border x:Name="HeaderVersionBadge" Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderVersionText" Text="v1.2.0" Foreground="#9A9A9A" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CacheManageBtn" Margin="0,0,8,0" ToolTip="Quản lý bộ nhớ đệm Cache &amp; Chọn địa chỉ lưu Cache" Click="CacheManageBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconDatabase}" Stroke="#38BDF8" Width="12" Height="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Cache" Foreground="#E5E5E5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border x:Name="HeaderCacheSizeBadge" Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderCacheSizeText" Text="0 KB" Foreground="#9A9A9A" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RescanBtn" ToolTip="Quét lại toàn bộ file mới tải về" Click="RescanBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconRefresh}" Width="12" Height="12" Margin="0,0,5,0"/>
                            <TextBlock Text="Quét lại" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. TAG CHIPS & TAG TOOLS BAR (Unified Row 1 - Flat Surface #181818, Border #262626) -->
        <Border Grid.Row="1" Background="#181818" BorderBrush="#262626" BorderThickness="0,0,0,1" Padding="12,6,12,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dynamic Tag Chips that WRAP automatically onto multiple lines -->
                <WrapPanel x:Name="TagChipsPanel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Populated dynamically with [Tất cả], [⚪ Chưa tag (9.572)], [🏷 Nhạc Mỹ], etc. -->
                </WrapPanel>

                <!-- Unified Tag Actions Toolbar (Top Right) -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4,0,0,4">
                    <!-- Quick Add Tag Input -->
                    <Grid VerticalAlignment="Center" Margin="0,0,4,4">
                        <TextBox x:Name="NewTagInput"
                                 Width="130"
                                 Background="#141414"
                                 Foreground="#FFFFFF"
                                 CaretBrush="#E50914"
                                 BorderBrush="#2E2E2E"
                                 BorderThickness="1"
                                 FontSize="13"
                                 Padding="7,4"
                                 KeyDown="NewTagInput_KeyDown"
                                 TextChanged="NewTagInput_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="3"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock x:Name="NewTagPlaceholder"
                                   Text="+ Tag mới..."
                                   Foreground="#737373"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </Grid>

                    <Button x:Name="AddNewTagBtn"
                            Content="+ Thêm"
                            Margin="0,0,5,4"
                            Padding="8,4"
                            FontSize="13"
                            ToolTip="Thêm tag mới vào thư viện (nhấn Enter)"
                            Click="AddNewTagBtn_Click"/>

                    <Button x:Name="ManageTagsBtn"
                            Margin="0,0,5,4"
                            Padding="8,4"
                            FontSize="13"
                            Background="#1F1F1F"
                            BorderBrush="#2D2D2D"
                            Foreground="#B3B3B3"
                            ToolTip="Quản lý, đổi tên, xóa tag khỏi thư viện"
                            Click="ManageTagsBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconGear}" Width="12" Height="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Quản lý" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SyncTagsBtn"
                            Visibility="Collapsed"
                            Margin="0,0,6,4"
                            Padding="8,4"
                            FontSize="13"
                            Background="#1F1F1F"
                            BorderBrush="#2D2D2D"
                            Foreground="#B3B3B3"
                            ToolTip="Đồng bộ Tags &amp; Thư mục với Dropbox (ổ F)"
                            Click="SyncTagsBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconCloud}" Width="12" Height="12" Margin="0,0,4,0"/>
                            <TextBlock x:Name="SyncTagsText" Text="Đồng bộ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Multi-tag filter logic button: VÀ / HOẶC -->
                    <Button x:Name="TagFilterLogicBtn"
                            Margin="0,0,5,4"
                            Padding="8,4"
                            FontWeight="Bold"
                            FontSize="13"
                            Background="#262626"
                            BorderBrush="#383838"
                            Foreground="#FFFFFF"
                            Content="Lọc: VÀ"
                            ToolTip="Chế độ lọc multi tag: VÀ (Khớp tất cả các tag đã chọn) - Click để chuyển sang HOẶC"
                            Click="TagFilterLogicBtn_Click"/>

                    <!-- Toggle Right Sidebar Button: 🏷️ Sidebar Tag Nhanh -->
                    <Button x:Name="ToggleRightSidebarBtn"
                            Margin="0,0,0,4"
                            Padding="10,4"
                            FontWeight="SemiBold"
                            FontSize="12.5"
                            Background="#1F1914"
                            BorderBrush="#46361D"
                            Foreground="#F4F4F5"
                            ToolTip="Bật/Tắt Sidebar Tag Nhanh ở cạnh phải (Phím tắt: Ctrl + T)"
                            Click="ToggleRightSidebarBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconTag}" Stroke="#F59E0B" Width="11" Height="11" Margin="0,0,5,0"/>
                            <TextBlock x:Name="ToggleRightSidebarText" Text="Sidebar Tag Nhanh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 3. MAIN BODY (Sidebar + Virtualized SFX List + Right Quick Tag Sidebar) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" MinWidth="180" MaxWidth="400"/> <!-- Col 0: Left Sidebar (Thư mục & Bin) -->
                <ColumnDefinition Width="Auto"/> <!-- Col 1: Left Splitter -->
                <ColumnDefinition Width="*"/>    <!-- Col 2: Center Content (SFX List / Grid) -->
                <ColumnDefinition Width="Auto"/> <!-- Col 3: Right Splitter -->
                <ColumnDefinition x:Name="RightSidebarColumn" Width="305" MinWidth="240" MaxWidth="450"/> <!-- Col 4: Right Sidebar (Tag Nhanh) -->
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="#121216" BorderBrush="#23232B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modern Studio Dark Sidebar Header -->
                    <Border Grid.Row="0" Background="#15151A" Padding="10,10,10,10" BorderBrush="#23232B" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="#1E1A14" BorderBrush="#3D311E" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFolder}" Stroke="#F59E0B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="THƯ MỤC &amp; BIN" FontSize="11.5" FontWeight="Bold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox x:Name="IncludeSubfoldersCheck"
                                          Style="{StaticResource StudioPillCheckBoxStyle}"
                                          Content="Thư mục con"
                                          IsChecked="False"
                                          FontSize="11.5"
                                          Padding="7,3"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          ToolTip="Bao gồm cả file trong các thư mục con bên trong"
                                          Checked="IncludeSubfoldersCheck_Changed"
                                          Unchecked="IncludeSubfoldersCheck_Changed"/>
                            </Grid>

                            <!-- DaVinci Resolve Bin & Import Actions: Single balanced 3-column row -->
                            <Grid Margin="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="CreateBinBtn"
                                        Style="{StaticResource SidebarPrimaryActionButtonStyle}"
                                        ToolTip="Tạo thư mục Bin ảo mới (Phím tắt: Ctrl + N)"
                                        Click="CreateBinBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolderPlus}" Stroke="#F59E0B" Width="12" Height="12" Margin="0,0,5,0"/>
                                        <TextBlock Text="Tạo Bin" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        x:Name="ImportFolderBtn"
                                        Style="{StaticResource SidebarToolbarButtonStyle}"
                                        ToolTip="Import một thư mục từ máy tính thành Bin mới"
                                        Click="ImportFolderBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolderImport}" Stroke="#38BDF8" Width="12" Height="12" Margin="0,0,5,0"/>
                                        <TextBlock Text="Thư mục" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4"
                                        x:Name="ImportFileBtn"
                                        Style="{StaticResource SidebarToolbarButtonStyle}"
                                        ToolTip="Import các file âm thanh lẻ vào thư viện SFX"
                                        Click="ImportFileBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconAudioFile}" Stroke="#A78BFA" Width="11" Height="12" Margin="0,0,5,0"/>
                                        <TextBlock Text="File" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="BinTreeScrollViewer"
                                  Grid.Row="1"
                                  Background="Transparent"
                                  AllowDrop="True"
                                  DragOver="FolderTreeView_DragOver"
                                  DragLeave="FolderTreeView_DragLeave"
                                  Drop="FolderTreeView_Drop"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,8" Background="Transparent">
                            <!-- All SFX Root Library Card (Supports dropping bins to unparent them to root) -->
                            <Button x:Name="AllSfxFolderBtn"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#1F1519"
                                    BorderBrush="#881337"
                                    Padding="9,7"
                                    Margin="0,0,0,6"
                                    Cursor="Hand"
                                    AllowDrop="True"
                                    DragOver="AllSfxFolderBtn_DragOver"
                                    Drop="AllSfxFolderBtn_Drop"
                                    Click="AllSfxFolderBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RootCardBd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RootCardBd" Property="BorderBrush" Value="#E11D48"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="#2B141C" BorderBrush="#6B1D2F" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconLibrary}" Stroke="#FB7185" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Thư viện gốc (Tất cả SFX)" FontSize="12.5" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Background="#111115" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AllCountBadge" Text="0" FontSize="11.5" FontWeight="Bold" Foreground="#E4E4E7"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Hidden reference for background untagged count updates -->
                            <TextBlock x:Name="UntaggedCountBadge" Visibility="Collapsed"/>

                            <!-- Hierarchical Virtual Folders Tree (DaVinci Resolve Style with Drag-Drop & Inline Rename) -->
                            <TreeView x:Name="FolderTreeView"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="#B3B3B3"
                                      Padding="0"
                                      AllowDrop="True"
                                      Drop="FolderTreeView_Drop"
                                      DragOver="FolderTreeView_DragOver"
                                      DragLeave="FolderTreeView_DragLeave"
                                      PreviewMouseLeftButtonDown="FolderTreeView_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="FolderTreeView_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="FolderTreeView_PreviewMouseLeftButtonUp"
                                      KeyDown="FolderTreeView_KeyDown"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                                      TreeViewItem.Expanded="FolderTreeView_ItemExpanded"
                                      TreeViewItem.Collapsed="FolderTreeView_ItemCollapsed">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Tạo Bin mới..." Click="CreateBinBtn_Click">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource IconFolderPlus}" Stroke="#B3B3B3" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Import Thư mục thành Bin..." Click="ImportFolderBtn_Click">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource IconFolderImport}" Stroke="#B3B3B3" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Import File âm thanh..." Click="ImportFileBtn_Click">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource IconAudioFile}" Stroke="#B3B3B3" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Tải lại cây thư mục" Click="RescanBtn_Click">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource IconRefresh}" Stroke="#B3B3B3" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Border x:Name="RowBorder" CornerRadius="4" Padding="4,2" Margin="0,1"
                                                ContextMenu="{StaticResource FolderItemContextMenu}"
                                                Tag="{Binding}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                            <Setter Property="Background" Value="#2A2214"/>
                                                            <Setter Property="BorderBrush" Value="#C59B27"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Height="26">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                    <ColumnDefinition Width="*"/>    <!-- Name / Inline Edit -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Link & Sync Buttons -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Count -->
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolder}" Stroke="#C59B27" Width="13" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                
                                                <!-- Container for TextBlock and Inline TextBox -->
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="BinNameTextBlock"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               Foreground="#E5E5E5"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding LinkedTooltip}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBox x:Name="BinInlineTextBox"
                                                             Text="{Binding Name, Mode=OneWay}"
                                                             FontSize="12.5"
                                                             Background="#141414"
                                                             Foreground="#FFFFFF"
                                                             CaretBrush="#E50914"
                                                             BorderBrush="#E50914"
                                                             BorderThickness="1"
                                                             Padding="3,1"
                                                             VerticalAlignment="Center"
                                                             IsVisibleChanged="BinInlineTextBox_IsVisibleChanged"
                                                             KeyDown="BinInlineTextBox_KeyDown"
                                                             LostFocus="BinInlineTextBox_LostFocus">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                        <TextBox.Resources>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="CornerRadius" Value="3"/>
                                                            </Style>
                                                        </TextBox.Resources>
                                                    </TextBox>
                                                </Grid>

                                                <!-- Folder Link (🔗) & Quick Sync (🔄) Inline Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <Button x:Name="BinLinkBtn"
                                                            Padding="4,3"
                                                            Margin="0,0,2,0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ToolTip="{Binding LinkedTooltip}"
                                                            Click="BinRowLinkBtn_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Foreground" Value="#737373"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLinkedPath}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowBorder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#2D2D2D"/>
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconLink}" Width="11" Height="11"/>
                                                    </Button>

                                                    <Button x:Name="BinSyncBtn"
                                                            Padding="4,3"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ToolTip="Đồng bộ file mới từ thư mục ổ đĩa liên kết ngay"
                                                            Click="BinRowSyncBtn_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Foreground" Value="#808080"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLinkedPath}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#2D2D2D"/>
                                                                        <Setter Property="Foreground" Value="#46D369"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconRefresh}" Width="11" Height="11"/>
                                                    </Button>
                                                </StackPanel>

                                                <Border Grid.Column="3" Background="#262626" CornerRadius="4" Padding="6,2" Margin="4,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountDisplay}" FontSize="12.5" Foreground="#B3B3B3"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="3" Background="#222222" HorizontalAlignment="Stretch"/>

            <!-- Center Table / ListView -->
            <Grid x:Name="CenterContentGrid"
                  Grid.Column="2"
                  PreviewMouseMove="CenterContentGrid_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="CenterContentGrid_PreviewMouseLeftButtonUp">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: List Header / Status -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Subfolder Browser & Breadcrumb Navigation -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: DaVinci Resolve Style Column Headers (Sortable) -->
                    <RowDefinition Height="*"/>    <!-- Row 3: Virtualized ListView / Thumbnail Grid -->
                </Grid.RowDefinitions>

                <!-- List Header / Status (Row 0 - Modern Studio Dark Toolbar - Responsive Adaptive) -->
                <Border x:Name="MiddleToolbarBorder" Grid.Row="0" Background="#131317" Padding="12,6,12,6" BorderBrush="#23232B" BorderThickness="0,0,0,1" SizeChanged="MiddleToolbarBorder_SizeChanged">
                    <Grid x:Name="MiddleToolbarGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="NarrowActionsRow" Height="0"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Status (Left), Wide Actions (Center), View Mode (Right) -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status & Folder Pills -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Media Counter Status Pill -->
                                <Border Background="#18181F" BorderBrush="#272732" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#E11D48" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ResultCountText" Text="0 SFX" FontWeight="Bold" FontSize="12.5" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ActiveFilterBadge" Text="" Margin="6,0,0,0" Foreground="#FB7185" FontSize="12" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Active Folder Tag Pill -->
                                <Border x:Name="ActiveFolderPill" Visibility="Collapsed" Background="#1F1912" BorderBrush="#46361D" BorderThickness="1" CornerRadius="6" Padding="9,4" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFolder}" Stroke="#F59E0B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="ActiveFolderNameText" Text="Thư mục" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" MaxWidth="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/>
                                        <Button x:Name="ClearActiveFolderBtn" Content="✕" Margin="6,0,0,0" Padding="3,0" Background="Transparent" BorderThickness="0" Foreground="#A1A1AA" Click="ClearActiveFolderBtn_Click" ToolTip="Bỏ lọc thư mục"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Host for Actions when Toolbar is Wide (1-row mode) -->
                            <ContentControl x:Name="WideActionsHost" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,8,0">
                                <WrapPanel x:Name="ToolbarActionsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Subtle Vertical Studio Divider (only visible in Wide 1-row mode) -->
                                    <Border x:Name="ToolbarDivider" Width="1" Height="18" Background="#252530" Margin="4,0,8,0" VerticalAlignment="Center"/>

                                    <!-- Auto Preview Studio Pill CheckBox with vector lightning icon -->
                                    <CheckBox x:Name="AutoPreviewCheck"
                                              Style="{StaticResource StudioPillCheckBoxStyle}"
                                              IsChecked="True"
                                              Padding="9,4"
                                              Margin="0,2,8,2"
                                              VerticalAlignment="Center"
                                              ToolTip="Tự động phát ngay khi click dòng hoặc dùng phím mũi tên ↑ / ↓"
                                              Checked="AutoPreviewCheck_Changed"
                                              Unchecked="AutoPreviewCheck_Changed">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconLightning}" Fill="#FBBF24" Width="9" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Auto preview" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Select All Studio Chip Button (Ctrl+A) -->
                                    <Button x:Name="SelectAllBtn"
                                            Style="{StaticResource StudioToolbarChipButtonStyle}"
                                            Padding="9,4"
                                            Margin="0,2,8,2"
                                            Background="#17171D"
                                            BorderBrush="#272732"
                                            Foreground="#D4D4D8"
                                            VerticalAlignment="Center"
                                            ToolTip="Chọn tất cả hoặc bỏ chọn tất cả mục đang hiển thị (Phím tắt: Ctrl + A, hoặc kéo chuột quét chọn)"
                                            Click="SelectAllBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="SelectAllCheckBoxBorder"
                                                    Width="14"
                                                    Height="14"
                                                    CornerRadius="3.5"
                                                    Background="#101014"
                                                    BorderBrush="#383846"
                                                    BorderThickness="1.2"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                                <Path x:Name="SelectAllCheckMark"
                                                      Data="M 2.2,6.2 L 5.0,9.0 L 10.8,3.2"
                                                      Stroke="#FFFFFF"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Visibility="Collapsed"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="SelectAllBtnText" Text="Chọn tất cả" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Refresh Current View Button (Ctrl+R / F5) -->
                                    <Button x:Name="RefreshCurrentViewBtn"
                                            Style="{StaticResource StudioToolbarChipButtonStyle}"
                                            Padding="9,4"
                                            Margin="0,2,8,2"
                                            Background="#17171D"
                                            BorderBrush="#272732"
                                            Foreground="#D4D4D8"
                                            VerticalAlignment="Center"
                                            ToolTip="Làm mới danh sách và kiểm tra lại toàn bộ file trên ổ đĩa (Phím tắt: Ctrl + R hoặc F5)"
                                            Click="RefreshCurrentViewBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconRefresh}" Width="11" Height="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Làm mới" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Bin Action Buttons for Selection -->
                                    <Button x:Name="AddSelectionToBinBtn"
                                            Style="{StaticResource StudioToolbarChipButtonStyle}"
                                            Visibility="Collapsed"
                                            Padding="9,4"
                                            Margin="0,2,8,2"
                                            Background="#1F1913"
                                            BorderBrush="#46361D"
                                            Foreground="#F4F4F5"
                                            VerticalAlignment="Center"
                                            ToolTip="Gán các file đang chọn vào một thư mục Bin ảo"
                                            Click="AddSelectionToBinBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolderPlus}" Stroke="#F59E0B" Width="12" Height="12" Margin="0,0,5,0"/>
                                            <TextBlock Text="Cho vào Bin..." FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="RemoveSelectionFromBinBtn"
                                            Style="{StaticResource StudioToolbarChipButtonStyle}"
                                            Visibility="Collapsed"
                                            Padding="9,4"
                                            Margin="0,2,0,2"
                                            Background="#241317"
                                            BorderBrush="#6B1D2F"
                                            Foreground="#FB7185"
                                            VerticalAlignment="Center"
                                            ToolTip="Xóa các thư mục hoặc file đang chọn khỏi phần mềm (Phím tắt: Delete)"
                                            Click="RemoveSelectionFromBinBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconTrash}" Stroke="#FB7185" Width="12" Height="12" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="RemoveSelectionFromBinText" Text="Xóa đã chọn" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </ContentControl>

                            <!-- Right Side: DaVinci Resolve View Mode Switcher (List / Thumbnail) & Size Slider -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <!-- Thumbnail Size Slider (Visible in Thumbnail Grid Mode) -->
                                <Border x:Name="ThumbnailSizeSliderPanel" Background="#17171D" BorderBrush="#272732" BorderThickness="1" CornerRadius="6" Padding="9,3" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Cỡ khung:" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <Slider x:Name="ThumbnailSizeSlider"
                                                Width="84"
                                                Minimum="160"
                                                Maximum="360"
                                                Value="240"
                                                VerticalAlignment="Center"
                                                ToolTip="Chỉnh kích thước ô Thumbnail (như DaVinci Resolve)"
                                                ValueChanged="ThumbnailSizeSlider_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Segmented View Mode Switcher: Danh sách (List) vs Thumbnail (DaVinci Grid) -->
                                <Border Background="#0D0D11" BorderBrush="#252530" BorderThickness="1" CornerRadius="7" Padding="2" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ListViewModeBtn"
                                                Style="{StaticResource StudioToolbarChipButtonStyle}"
                                                Padding="10,4"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Background="#E11D48"
                                                BorderBrush="#FB7185"
                                                Foreground="#FFFFFF"
                                                ToolTip="Chế độ xem Danh sách File (List View)"
                                                Click="ListViewModeBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconListView}" Width="12" Height="12" Margin="0,0,5,0"/>
                                                <TextBlock Text="File / Danh sách" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="GridViewModeBtn"
                                                Style="{StaticResource StudioToolbarChipButtonStyle}"
                                                Padding="10,4"
                                                Margin="2,0,0,0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Foreground="#A1A1AA"
                                                ToolTip="Chế độ xem Lưới Thumbnail &amp; Rê chuột xem trước Video như DaVinci Resolve"
                                                Click="GridViewModeBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconGridView}" Width="12" Height="12" Margin="0,0,5,0"/>
                                                <TextBlock Text="Thumbnail" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Narrow Actions Host (Only active when toolbar width is constrained) -->
                        <ContentControl x:Name="NarrowActionsHost" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Visibility="Collapsed" Margin="0,5,0,1"/>
                    </Grid>
                </Border>

                <!-- Subfolder Browser & Breadcrumb Navigation (Row 1) -->
                <Border x:Name="SubfoldersBrowserBorder"
                        Grid.Row="1"
                        Background="#141414"
                        BorderBrush="#262626"
                        BorderThickness="0,0,0,1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Breadcrumb & Back Bar -->
                            <RowDefinition Height="*"/>    <!-- Subfolder Cards WrapPanel -->
                        </Grid.RowDefinitions>

                        <!-- Breadcrumb & Back Navigation Header -->
                        <Border x:Name="FolderBreadcrumbBar"
                                Grid.Row="0"
                                Background="#171717"
                                BorderBrush="#222222"
                                BorderThickness="0,0,0,1"
                                Padding="12,7,12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Back Button -->
                                <Button x:Name="FolderBackBtn"
                                        Grid.Column="0"
                                        Content="⬅ Quay lại"
                                        Padding="9,3"
                                        Margin="0,0,10,0"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Background="#242424"
                                        BorderBrush="#383838"
                                        Foreground="#E5E5E5"
                                        VerticalAlignment="Center"
                                        ToolTip="Quay lại thư mục cha"
                                        Click="FolderBackBtn_Click"/>

                                <!-- Breadcrumb Path Items -->
                                <ScrollViewer Grid.Column="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Center">
                                    <StackPanel x:Name="FolderBreadcrumbPanel"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"/>
                                </ScrollViewer>

                                <!-- Subfolder Count Badge -->
                                <Border x:Name="SubfolderCountBadgeBorder"
                                        Grid.Column="2"
                                        Background="#222222"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="SubfolderCountBadgeText"
                                               Text="0 thư mục"
                                               FontSize="12"
                                               Foreground="#C59B27"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Subfolder Views (Supports List View vs Thumbnail Grid View + Marquee Selection) -->
                        <ScrollViewer x:Name="SubfoldersScrollViewer"
                                      Grid.Row="1"
                                      MaxHeight="215"
                                      Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="12,10,12,10"
                                      PreviewMouseLeftButtonDown="SubfoldersScrollViewer_PreviewMouseLeftButtonDown">
                            <StackPanel Background="Transparent">
                                <!-- List Mode Table Header (Active in List View) -->
                                <Border x:Name="FolderListHeaderBorder"
                                        Background="#161616"
                                        BorderBrush="#262626"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,6,10,6"
                                        Margin="0,0,0,8"
                                        CornerRadius="5"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>  <!-- Icon -->
                                            <ColumnDefinition Width="*"/>   <!-- Tên thư mục -->
                                            <ColumnDefinition Width="160"/> <!-- Thư mục con -->
                                            <ColumnDefinition Width="240"/> <!-- Liên kết ổ đĩa -->
                                            <ColumnDefinition Width="36"/>  <!-- Action -->
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="TÊN THƯ MỤC" FontSize="11.5" FontWeight="Bold" Foreground="#71717A" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="THƯ MỤC CON" FontSize="11.5" FontWeight="Bold" Foreground="#71717A"/>
                                        <TextBlock Grid.Column="3" Text="LIÊN KẾT Ổ ĐĨA" FontSize="11.5" FontWeight="Bold" Foreground="#71717A"/>
                                        <TextBlock Grid.Column="4" Text="MỞ" FontSize="11.5" FontWeight="Bold" Foreground="#71717A" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Mode 1: List View Rows (Active in File / Danh sách Mode) -->
                                <ItemsControl x:Name="SubfoldersListItemsControl" Background="Transparent" Visibility="Visible">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Background="Transparent"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,4"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    Click="SubfolderCard_Click"
                                                    ContextMenu="{StaticResource FolderItemContextMenu}"
                                                    Tag="{Binding}"
                                                    ToolTip="Click để mở thư mục • Kéo chuột quét chọn hoặc Ctrl+Click để chọn nhiều • Nhấn Delete để xóa">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="FolderRowBorder"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10,6"
                                                                SnapsToDevicePixels="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40"/>  <!-- Icon -->
                                                                    <ColumnDefinition Width="*"/>   <!-- Folder Name -->
                                                                    <ColumnDefinition Width="160"/> <!-- Thư mục con -->
                                                                    <ColumnDefinition Width="240"/> <!-- Liên kết ổ đĩa -->
                                                                    <ColumnDefinition Width="36"/>  <!-- Action -->
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Folder Icon Box with Checkmark -->
                                                                <Grid Grid.Column="0" Width="30" Height="30" VerticalAlignment="Center">
                                                                    <Border x:Name="FolderIconBox"
                                                                            CornerRadius="6"
                                                                            Background="#241E14"
                                                                            BorderBrush="#453416"
                                                                            BorderThickness="1">
                                                                        <Path Data="{StaticResource IconFolder}"
                                                                              Stroke="#F59E0B"
                                                                              StrokeThickness="1.8"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round"
                                                                              StrokeLineJoin="Round"
                                                                              Fill="Transparent"
                                                                              Width="15"
                                                                              Height="15"
                                                                              Stretch="Uniform"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border x:Name="SelectedCheckBadge"
                                                                            Width="16"
                                                                            Height="16"
                                                                            CornerRadius="8"
                                                                            Background="#E11D48"
                                                                            BorderBrush="#FFFFFF"
                                                                            BorderThickness="1"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,-3,-3,0"
                                                                            Visibility="Collapsed">
                                                                        <TextBlock Text="✓" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                                    </Border>
                                                                </Grid>

                                                                <!-- Folder Name -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="13.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#FFFFFF"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <!-- Subfolder Count -->
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                                    <Border Background="#202020" BorderBrush="#303030" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                                        <TextBlock Text="{Binding Children.Count, StringFormat='{}📁 {0} thư mục con'}"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#A1A1AA"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Linked Path -->
                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="{Binding LinkedTooltip}">
                                                                    <TextBlock Text="{Binding LinkedPath, FallbackValue='(Thư mục ảo)'}"
                                                                               FontSize="12"
                                                                               Foreground="#71717A"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <!-- Chevron / Open Indicator -->
                                                                <TextBlock Grid.Column="4"
                                                                           Text="›"
                                                                           FontSize="20"
                                                                           FontWeight="Bold"
                                                                           Foreground="#52525B"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="FolderRowBorder" Property="Background" Value="#222222"/>
                                                                <Setter TargetName="FolderRowBorder" Property="BorderBrush" Value="#383838"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                                                                <Setter TargetName="FolderRowBorder" Property="Background" Value="#2D141E"/>
                                                                <Setter TargetName="FolderRowBorder" Property="BorderBrush" Value="#E11D48"/>
                                                                <Setter TargetName="SelectedCheckBadge" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="FolderRowBorder" Property="Background" Value="#1A1A1A"/>
                                                                <Setter TargetName="FolderRowBorder" Property="BorderBrush" Value="#383838"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Mode 2: Thumbnail Cards Grid (Active in Thumbnail Mode) -->
                                <ItemsControl x:Name="SubfoldersThumbnailItemsControl" Background="Transparent" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" Background="Transparent"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="{DynamicResource ThumbnailCardWidth}"
                                                    Margin="0,0,12,12"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    Click="SubfolderCard_Click"
                                                    ContextMenu="{StaticResource FolderItemContextMenu}"
                                                    Tag="{Binding}"
                                                    ToolTip="Click để mở thư mục • Kéo chuột quét chọn hoặc Ctrl+Click để chọn nhiều • Nhấn Delete để xóa">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="FolderTileBorder"
                                                                Background="#181818"
                                                                BorderBrush="#2A2A2A"
                                                                BorderThickness="1.5"
                                                                CornerRadius="8"
                                                                SnapsToDevicePixels="True"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/> <!-- Thumbnail Graphic Frame -->
                                                                    <RowDefinition Height="Auto"/> <!-- Title & Meta Footer -->
                                                                </Grid.RowDefinitions>

                                                                <!-- Thumbnail Graphic Frame: scales with ThumbnailCardImageHeight -->
                                                                <Border Grid.Row="0"
                                                                        x:Name="TileVisualBox"
                                                                        Height="{DynamicResource ThumbnailCardImageHeight}"
                                                                        CornerRadius="7,7,0,0">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#202020" Offset="0.0"/>
                                                                            <GradientStop Color="#141414" Offset="1.0"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <Grid>
                                                                        <!-- Ambient glowing circle behind icon -->
                                                                        <Ellipse Width="76" Height="76" Fill="#F59E0B" Opacity="0.06" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                                        <!-- Central Folder Emblem -->
                                                                        <Border Width="52" Height="44"
                                                                                CornerRadius="8"
                                                                                Background="#281E11"
                                                                                BorderBrush="#4C3614"
                                                                                BorderThickness="1.2"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource IconFolder}"
                                                                                  Stroke="#F59E0B"
                                                                                  StrokeThickness="2.0"
                                                                                  StrokeStartLineCap="Round"
                                                                                  StrokeEndLineCap="Round"
                                                                                  StrokeLineJoin="Round"
                                                                                  Fill="Transparent"
                                                                                  Width="26"
                                                                                  Height="26"
                                                                                  Stretch="Uniform"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                                        </Border>

                                                                        <!-- Top-Right: Media Count Pill -->
                                                                        <Border Background="#20180F"
                                                                                BorderBrush="#4A3414"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="6,2"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Top"
                                                                                Margin="0,7,7,0">
                                                                            <TextBlock Text="{Binding TotalCount, StringFormat='{}{0:N0} media'}"
                                                                                       FontSize="11.5"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#FBBF24"/>
                                                                        </Border>

                                                                        <!-- Top-Left: Subfolder Count (if any) -->
                                                                        <Border x:Name="SubfolderTileBadge"
                                                                                Background="#202020"
                                                                                BorderBrush="#303030"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="6,2"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Top"
                                                                                Margin="7,7,0,0"
                                                                                Visibility="Collapsed">
                                                                            <TextBlock Text="{Binding Children.Count, StringFormat='{}📁 {0} con'}"
                                                                                       FontSize="11"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="#A1A1AA"/>
                                                                        </Border>

                                                                        <!-- Bottom-Left: Linked folder pill (if any) -->
                                                                        <Border x:Name="LinkedTileBadge"
                                                                                Background="#0F2417"
                                                                                BorderBrush="#18422A"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="5,1"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Bottom"
                                                                                Margin="7,0,0,6"
                                                                                Visibility="Collapsed">
                                                                            <TextBlock Text="🔗 Auto-Sync"
                                                                                       FontSize="10.5"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#34D399"/>
                                                                        </Border>

                                                                        <!-- Selection Checkmark Badge -->
                                                                        <Border x:Name="SelectedCheckBadge"
                                                                                Width="20"
                                                                                Height="20"
                                                                                CornerRadius="10"
                                                                                Background="#E11D48"
                                                                                BorderBrush="#FFFFFF"
                                                                                BorderThickness="1.5"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Top"
                                                                                Margin="0,6,6,0"
                                                                                Visibility="Collapsed">
                                                                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Title & Meta Footer -->
                                                                <Border Grid.Row="1"
                                                                        Background="#161616"
                                                                        BorderBrush="#262626"
                                                                        BorderThickness="0,1,0,0"
                                                                        Padding="9,7,9,8">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="13"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#F4F4F5"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding SubfolderSummaryText}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="#A1A1AA"
                                                                                   Margin="0,3,0,0"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="FolderTileBorder" Property="BorderBrush" Value="#E11D48"/>
                                                                <Setter TargetName="FolderTileBorder" Property="Background" Value="#222222"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                                                <Setter TargetName="SubfolderTileBadge" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasLinkedPath}" Value="True">
                                                                <Setter TargetName="LinkedTileBadge" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                                                                <Setter TargetName="FolderTileBorder" Property="Background" Value="#2D141E"/>
                                                                <Setter TargetName="FolderTileBorder" Property="BorderBrush" Value="#E11D48"/>
                                                                <Setter TargetName="FolderTileBorder" Property="BorderThickness" Value="2"/>
                                                                <Setter TargetName="SelectedCheckBadge" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="FolderTileBorder" Property="Opacity" Value="0.88"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- DaVinci Resolve Media Pool Column Headers (Sortable, Row 2) -->
                <Border x:Name="ListColumnHeaderBorder" Grid.Row="2" Background="#161616" BorderBrush="#262626" BorderThickness="0,0,0,1" Padding="8,4,8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>  <!-- Play Header -->
                            <ColumnDefinition Width="*"/>   <!-- Title & Tags -->
                            <ColumnDefinition Width="160"/> <!-- Folder / Path -->
                            <ColumnDefinition Width="72"/>  <!-- Duration -->
                            <ColumnDefinition Width="56"/>  <!-- Ext -->
                            <ColumnDefinition Width="72"/>  <!-- Size -->
                        </Grid.ColumnDefinitions>

                        <!-- Play Column -->
                        <Path Grid.Column="0" Data="{StaticResource IconPlay}" Fill="#555555" Width="7" Height="7" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- TÊN FILE & TAGS -->
                        <Button Grid.Column="1" x:Name="SortNameHeaderBtn" Style="{StaticResource HeaderSortButtonStyle}" Click="SortHeader_Click" Tag="Name">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="TÊN FILE &amp; TAGS" Style="{StaticResource HeaderSortTextStyle}"/>
                                <TextBlock x:Name="SortNameArrow" Text=" ▾" Style="{StaticResource HeaderSortArrowStyle}"/>
                            </StackPanel>
                        </Button>

                        <!-- THƯ MỤC -->
                        <Button Grid.Column="2" x:Name="SortFolderHeaderBtn" Style="{StaticResource HeaderSortButtonStyle}" Click="SortHeader_Click" Tag="Folder">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="THƯ MỤC" Style="{StaticResource HeaderSortTextStyle}"/>
                                <TextBlock x:Name="SortFolderArrow" Text=" ▾" Style="{StaticResource HeaderSortArrowStyle}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- THỜI LƯỢNG -->
                        <Button Grid.Column="3" x:Name="SortDurationHeaderBtn" Style="{StaticResource HeaderSortButtonStyle}" Click="SortHeader_Click" Tag="Duration" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="THỜI LƯỢNG" Style="{StaticResource HeaderSortTextStyle}"/>
                                <TextBlock x:Name="SortDurationArrow" Text=" ▾" Style="{StaticResource HeaderSortArrowStyle}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- ĐỊNH DẠNG -->
                        <Button Grid.Column="4" x:Name="SortExtHeaderBtn" Style="{StaticResource HeaderSortButtonStyle}" Click="SortHeader_Click" Tag="Extension" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LOẠI" Style="{StaticResource HeaderSortTextStyle}"/>
                                <TextBlock x:Name="SortExtArrow" Text=" ▾" Style="{StaticResource HeaderSortArrowStyle}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- DUNG LƯỢNG -->
                        <Button Grid.Column="5" x:Name="SortSizeHeaderBtn" Style="{StaticResource HeaderSortButtonStyle}" Click="SortHeader_Click" Tag="Size" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DUNG LƯỢNG" Style="{StaticResource HeaderSortTextStyle}"/>
                                <TextBlock x:Name="SortSizeArrow" Text=" ▾" Style="{StaticResource HeaderSortArrowStyle}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Virtualized ListView (Row 3 - Mode 1: List View) -->
                <ListView Grid.Row="3"
                          x:Name="SfxListView"
                          SelectionMode="Extended"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          SelectionChanged="SfxListView_SelectionChanged"
                          MouseDoubleClick="SfxListView_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="SfxListView_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="SfxListView_PreviewMouseMove"
                          PreviewMouseRightButtonDown="SfxItem_PreviewMouseRightButtonDown"
                          PreviewMouseRightButtonUp="SfxItem_PreviewMouseRightButtonUp">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>  <!-- Play Icon -->
                                    <ColumnDefinition Width="*"/>   <!-- Title & Tags -->
                                    <ColumnDefinition Width="160"/> <!-- Folder / Path -->
                                    <ColumnDefinition Width="72"/>  <!-- Duration -->
                                    <ColumnDefinition Width="56"/>  <!-- Ext -->
                                    <ColumnDefinition Width="72"/>  <!-- Size -->
                                </Grid.ColumnDefinitions>

                                <!-- Play Button (Row Play) -->
                                <Border Grid.Column="0"
                                        Background="#222222"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip="{Binding RowActionButtonToolTip}"
                                        PreviewMouseLeftButtonDown="RowPlayButton_PreviewMouseLeftButtonDown">
                                    <Path Data="{Binding PlayPathData}" Fill="#FFFFFF" Width="8" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- File Name & Tags -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Visibility="{Binding MediaTypeBadgeVisibility}" Background="{Binding MediaTypeBadgeBackground}" BorderBrush="{Binding MediaTypeBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MediaTypeBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding MediaTypeBadgeForeground}"/>
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14.5" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TagsDisplay}" FontSize="12.5" Foreground="#8C8C8C" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="{Binding HasTags, Converter={x:Null}, FallbackValue=Visible}"/>
                                </StackPanel>

                                <!-- Folder -->
                                <TextBlock Grid.Column="2" Text="{Binding FolderName}" FontSize="13" Foreground="#737373" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                <!-- Duration -->
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="13" Foreground="#B3B3B3" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- Format -->
                                <Border Grid.Column="4" Background="#1F1F1F" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Extension}" FontSize="12.5" FontWeight="Bold" Foreground="#8C8C8C"/>
                                </Border>

                                <!-- Size -->
                                <TextBlock Grid.Column="5" Text="{Binding FileSizeText}" FontSize="12.5" Foreground="#737373" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- DaVinci Resolve Media Pool Thumbnail Grid View (Row 3 - Mode 2: Thumbnail Scrubbing View) -->
                <ListBox Grid.Row="3"
                         x:Name="SfxThumbnailListBox"
                         Visibility="Collapsed"
                         Background="#121212"
                         BorderThickness="0"
                         Padding="10,10,6,10"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.CanContentScroll="False"
                         SelectionChanged="SfxThumbnailListBox_SelectionChanged"
                         MouseDoubleClick="SfxListView_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="SfxListView_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="SfxListView_PreviewMouseMove"
                         PreviewMouseRightButtonDown="SfxItem_PreviewMouseRightButtonDown"
                         PreviewMouseRightButtonUp="SfxItem_PreviewMouseRightButtonUp">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,14"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardOuterBorder"
                                                Background="#1B1B1B"
                                                BorderBrush="#2C2C2C"
                                                BorderThickness="1.5"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardOuterBorder" Property="BorderBrush" Value="#737373"/>
                                                <Setter TargetName="CardOuterBorder" Property="Background" Value="#222222"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardOuterBorder" Property="BorderBrush" Value="#E50914"/>
                                                <Setter TargetName="CardOuterBorder" Property="Background" Value="#261718"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="{DynamicResource ThumbnailCardWidth}">
                                <!-- 16:9 Video / Media Preview Box with DaVinci Resolve Hover Scrubbing -->
                                <Border Height="{DynamicResource ThumbnailCardImageHeight}"
                                        Background="#0A0A0A"
                                        CornerRadius="5,5,0,0"
                                        ClipToBounds="True"
                                        Cursor="Hand"
                                        MouseEnter="ThumbnailCard_MouseEnter"
                                        MouseMove="ThumbnailCard_MouseMove"
                                        MouseLeave="ThumbnailCard_MouseLeave">
                                    <Grid>
                                        <!-- Fallback Placeholder when thumbnail is loading or for audio items -->
                                        <Grid Visibility="{Binding PlaceholderVisibility}" Background="#111111">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconVideo}"
                                                      Visibility="{Binding VideoBadgeVisibility}"
                                                      Stroke="#38BDF8"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Fill="Transparent"
                                                      Width="34"
                                                      Height="34"
                                                      Stretch="Uniform"
                                                      Opacity="0.65"
                                                      HorizontalAlignment="Center"/>
                                                <Path Data="{StaticResource IconImage}"
                                                      Visibility="{Binding ImageBadgeVisibility}"
                                                      Stroke="#4ADE80"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Fill="Transparent"
                                                      Width="34"
                                                      Height="34"
                                                      Stretch="Uniform"
                                                      Opacity="0.75"
                                                      HorizontalAlignment="Center"/>
                                                <Path Data="{StaticResource IconPalette}"
                                                      Visibility="{Binding DesignBadgeVisibility}"
                                                      Stroke="#C084FC"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Fill="Transparent"
                                                      Width="34"
                                                      Height="34"
                                                      Stretch="Uniform"
                                                      Opacity="0.75"
                                                      HorizontalAlignment="Center"/>
                                                <Path Data="{StaticResource IconAudioWave}"
                                                      Visibility="{Binding AudioIconVisibility}"
                                                      Stroke="#E50914"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Fill="Transparent"
                                                      Width="32"
                                                      Height="32"
                                                      Stretch="Uniform"
                                                      Opacity="0.65"
                                                      HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Extension}"
                                                            FontSize="11.5"
                                                            FontWeight="Bold"
                                                            Foreground="#666666"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Extracted Poster Thumbnail / Live Hover-Scrubbed Frame -->
                                        <Image Source="{Binding DisplayImageSource}"
                                               Visibility="{Binding HasThumbnailVisibility}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="Linear"/>

                                        <!-- Top-Left Badge: Resolution / Format -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" IsHitTestVisible="False">
                                            <Border Background="#CC141414" BorderBrush="#44FFFFFF" BorderThickness="0.5" CornerRadius="3" Padding="5,1.5">
                                                <TextBlock Text="{Binding ResolutionBadge}" FontSize="10.5" FontWeight="Bold" Foreground="#E5E5E5"/>
                                            </Border>
                                            <Border Visibility="{Binding CloudBadgeVisibility}" Background="#CC0C2D48" BorderBrush="#38BDF8" BorderThickness="0.8" CornerRadius="3" Padding="5,1.5" Margin="4,0,0,0">
                                                <TextBlock Text="☁ Cloud" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Bottom-Left Play/Audio Indicator (like DaVinci Resolve's little waveform/play badge) -->
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="6,0,0,6"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                Background="#CC1A1A1A"
                                                BorderBrush="#55FFFFFF"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                ToolTip="{Binding RowActionButtonToolTip}"
                                                PreviewMouseLeftButtonDown="RowPlayButton_PreviewMouseLeftButtonDown">
                                            <Path Data="{Binding PlayPathData}" Fill="#FFFFFF" Width="8" Height="8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Bottom-Right Duration & Size Pill -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,6,6"
                                                Background="#CC141414"
                                                CornerRadius="3"
                                                Padding="5,1.5"
                                                IsHitTestVisible="False">
                                            <TextBlock Text="{Binding DurationText}" FontSize="11" FontFamily="Consolas" Foreground="#D4D4D4"/>
                                        </Border>

                                        <!-- ================= DAVINCI RESOLVE HOVER SCRUBBING OVERLAY ================= -->
                                        <Grid Visibility="{Binding ScrubOverlayVisibility}" IsHitTestVisible="False">
                                            <!-- Top-Right Live Scrub Timestamp -->
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,6,6,0"
                                                    Background="#E50914"
                                                    CornerRadius="3"
                                                    Padding="6,1.5">
                                                <TextBlock Text="{Binding ScrubTimeText}" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFFFFF"/>
                                            </Border>

                                            <!-- Vertical Red Playhead Scrub Line (follows mouse cursor X!) -->
                                            <Border Width="2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Stretch"
                                                    Background="#E50914"
                                                    Margin="{Binding ScrubLineMargin}">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                                                </Border.Effect>
                                            </Border>

                                            <!-- Bottom Track Background + Red Progress Bar -->
                                            <Border Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#66000000"/>
                                            <Border Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#E50914" Width="{Binding ScrubProgressWidth}"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Card Footer: Filename, Folder & Tags -->
                                <Border Padding="8,7,8,8" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F3F3F3"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FileName}"/>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FolderName}"
                                                       FontSize="11.5"
                                                       Foreground="#808080"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FileSizeText}"
                                                       FontSize="11"
                                                       Foreground="#666666"
                                                       Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Marquee Drag-Selection Rectangle Overlay (Kéo chuột quét chọn) -->
                <Canvas x:Name="MarqueeSelectionCanvas"
                        Grid.Row="1"
                        Grid.RowSpan="3"
                        IsHitTestVisible="False"
                        ClipToBounds="True"
                        Panel.ZIndex="92"
                        Visibility="Collapsed">
                    <Border x:Name="MarqueeSelectionBorder"
                            Background="#2EE50914"
                            BorderBrush="#E50914"
                            BorderThickness="1.5"
                            CornerRadius="3"/>
                </Canvas>

                <!-- DaVinci Resolve Style External Drag & Drop Import Overlay -->
                <Border x:Name="ExternalDropOverlayBorder"
                        Grid.Row="1"
                        Grid.RowSpan="3"
                        Margin="8"
                        Background="#D8121212"
                        BorderBrush="#C59B27"
                        BorderThickness="2"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="27" Background="#2A2214" BorderBrush="#C59B27" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Data="{StaticResource IconFolderImport}" Stroke="#C59B27" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Thả Thư mục hoặc File vào đây để Import (như Bin DaVinci)"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ExternalDropOverlayTargetText"
                                   Text="Giữ nguyên 100% cấu trúc thư mục con &amp; tự động bật Auto-Sync"
                                   FontSize="13.5"
                                   Foreground="#C59B27"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right Grid Splitter -->
            <GridSplitter x:Name="RightGridSplitter" Grid.Column="3" Width="3" Background="#222228" HorizontalAlignment="Stretch"/>

            <!-- Right Sidebar: Modern Studio Dark Quick Tag Panel & Inspector -->
            <Border x:Name="RightSidebarBorder" Grid.Column="4" Background="#121216" BorderBrush="#23232B" BorderThickness="1,0,0,0">
                <Border.Resources>
                    <!-- Style for Available Tag Buttons (Pills) -->
                    <Style x:Key="RightTagPillStyle" TargetType="{x:Type Button}">
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="pillBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="pillBorder" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="pillBorder" Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Inspector Content -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#15151A" Padding="14,12,12,12" BorderBrush="#23232B" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="5" Background="#201A14" BorderBrush="#45331B" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconTag}" Stroke="#F59E0B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="TAG NHANH" FontSize="13.5" FontWeight="Bold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="CloseRightSidebarBtn"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,3"
                                    Foreground="#888892"
                                    Cursor="Hand"
                                    ToolTip="Thu gọn Sidebar Tag nhanh (Ctrl + T)"
                                    Click="ToggleRightSidebarBtn_Click">
                                <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Inspector Content -->
                    <ScrollViewer Grid.Row="1"
                                  Background="Transparent"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12,12">
                        <StackPanel>
                            <!-- Active Selected File Card -->
                            <Border Background="#16161D" BorderBrush="#262634" BorderThickness="1" CornerRadius="8" Padding="12,11" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="5" Background="#26141B" BorderBrush="#501D2C" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path x:Name="RightSelectedFileIcon" Data="{StaticResource IconAudioWave}" Stroke="#FB7185" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="RightSelectedFileTitle"
                                                   Text="Chưa chọn âm thanh"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="RightSelectedFileMeta"
                                               Text="Click vào một âm thanh để xem và gán tag"
                                               FontSize="12.5"
                                               Foreground="#94A3B8"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,8"/>

                                    <!-- Tag hiện có của file đang chọn -->
                                    <Border BorderBrush="#23232B" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock Text="TAG HIỆN TẠI:" FontSize="12.5" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                                            <WrapPanel x:Name="RightCurrentTagsWrapPanel">
                                                <TextBlock x:Name="RightNoCurrentTagsText" Text="(Chưa có tag nào)" FontSize="12.5" Foreground="#71717A" FontStyle="Italic"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Add New Tag Quick Input -->
                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <TextBox x:Name="RightNewTagInput"
                                             Background="#111115"
                                             Foreground="#FFFFFF"
                                             CaretBrush="#E11D48"
                                             BorderBrush="#2A2A38"
                                             BorderThickness="1"
                                             FontSize="12.5"
                                             Padding="9,6"
                                             KeyDown="RightNewTagInput_KeyDown"
                                             TextChanged="RightNewTagInput_TextChanged">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBlock x:Name="RightNewTagPlaceholder"
                                               Text="+ Nhập tag mới..."
                                               Foreground="#71717A"
                                               FontSize="12.5"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </Grid>
                                <Button Grid.Column="2"
                                        x:Name="RightAddNewTagBtn"
                                        Style="{StaticResource SidebarPrimaryActionButtonStyle}"
                                        Content="+ Thêm"
                                        Padding="12,6"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        ToolTip="Thêm tag mới và tự gán cho âm thanh đang chọn (nhấn Enter)"
                                        Click="RightAddNewTagBtn_Click"/>
                            </Grid>

                            <!-- Tag Search Filter (In case library has 50+ tags) -->
                            <Grid Margin="0,0,0,10">
                                <TextBox x:Name="RightTagSearchInput"
                                         Background="#111115"
                                         Foreground="#FFFFFF"
                                         CaretBrush="#E11D48"
                                         BorderBrush="#252532"
                                         BorderThickness="1"
                                         FontSize="12.5"
                                         Padding="28,5,24,5"
                                         TextChanged="RightTagSearchInput_TextChanged">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <Path Data="{StaticResource IconSearch}" Stroke="#71717A" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock x:Name="RightTagSearchPlaceholder"
                                           Text="Tìm nhanh tag..."
                                           Foreground="#71717A"
                                           FontSize="12.5"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="29,0,0,0"/>
                                <Button x:Name="ClearRightTagSearchBtn"
                                        Content="✕"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,7,0"
                                        Padding="4,0"
                                        FontSize="12.5"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#94A3B8"
                                        Visibility="Collapsed"
                                        Click="ClearRightTagSearchBtn_Click"/>
                            </Grid>

                            <!-- Available Tags Section Header -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="BẢNG TAG (CLICK ĐỂ GÁN / GỠ)" FontSize="12.5" FontWeight="Bold" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RightTagCountSummary" Text="0 tag" FontSize="12.5" Foreground="#71717A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Available Tags Interactive Pill Grid -->
                            <WrapPanel x:Name="RightAvailableTagsWrapPanel" Orientation="Horizontal">
                                <!-- Populated dynamically -->
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. BOTTOM PLAYER & WAVEFORM (Theater black #181818 with Netflix Red Hero Play Button) -->
        <Border Grid.Row="3" Background="#181818" BorderBrush="#262626" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Now Playing Info -->
                    <RowDefinition Height="78"/>   <!-- Video Monitor + Waveform Canvas -->
                    <RowDefinition Height="Auto"/> <!-- Play Controls & Drag Handle -->
                </Grid.RowDefinitions>

                <!-- Now Playing Info -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="NowPlayingTitle" Text="Chưa chọn SFX" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" Cursor="Hand" ToolTip="Click chuột phải để mở vị trí file trong File Explorer" PreviewMouseRightButtonUp="NowPlaying_PreviewMouseRightButtonUp"/>
                        <TextBlock x:Name="NowPlayingMeta" Text="" Margin="10,0,0,0" FontSize="13" Foreground="#B3B3B3" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TimeDisplay" Text="00:00.0 / 00:00.0" FontSize="13" FontFamily="Consolas" Foreground="#B3B3B3"/>
                    </StackPanel>
                </Grid>

                <!-- Video Preview Monitor (when Video selected) + Waveform Control -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BottomVideoMonitorBorder"
                            Grid.Column="0"
                            Width="138"
                            Margin="0,0,10,0"
                            Background="#0A0A0A"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Visibility="Collapsed">
                        <Grid>
                            <Image x:Name="BottomVideoMonitorImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Background="#AA000000" CornerRadius="2" Padding="4,1">
                                <TextBlock Text="PREVIEW" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="4" BorderBrush="#262626" BorderThickness="1" ClipToBounds="True">
                        <controls:WaveformControl x:Name="WaveformView"/>
                    </Border>
                </Grid>

                <!-- Controls & Drag Handle -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Play, Pause, Loop -->
                        <ColumnDefinition Width="Auto"/> <!-- In/Out Trimming Controls -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Volume -->
                        <ColumnDefinition Width="Auto"/> <!-- Drag to Timeline Button -->
                    </Grid.ColumnDefinitions>

                    <!-- Play Controls: Netflix Red Hero Button (Sole driver of interaction) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="PlayBtn_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="PlayIconPath" Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlayBtnText" Text="Phát (Space)" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="LoopBtn" Click="LoopBtn_Click" Margin="0,0,12,0" Padding="10,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconLoop}" Width="12" Height="12" Margin="0,0,5,0"/>
                                <TextBlock Text="Lặp (L)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- In/Out Trimming -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SetInBtn" Content="[ I ] In" ToolTip="Đặt điểm bắt đầu In (phím I)" Click="SetInBtn_Click" Margin="0,0,4,0"/>
                        <Button x:Name="SetOutBtn" Content="[ O ] Out" ToolTip="Đặt điểm kết thúc Out (phím O)" Click="SetOutBtn_Click" Margin="0,0,4,0"/>
                        <Button x:Name="ClearInOutBtn" Content="✕ Xóa mốc" ToolTip="Xóa mốc chọn để lấy toàn bộ file" Click="ClearInOutBtn_Click" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TrimInfoText" Text="" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Volume Slider -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button x:Name="MuteBtn" Background="Transparent" BorderThickness="0" Padding="4,4" Click="MuteBtn_Click" Margin="0,0,4,0">
                            <Path x:Name="MuteIconPath" Data="{StaticResource IconSpeaker}" Stroke="#B3B3B3" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>

                    <!-- SOUNDLY-STYLE DRAG HANDLE BUTTON (Sleek dark Netflix action) -->
                    <Border Grid.Column="4"
                            x:Name="DragHandleTarget"
                            Background="#262626"
                            BorderBrush="#3D3D3D"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14,6"
                            Cursor="Hand"
                            ToolTip="BẤM GIỮ CHUỘT VÀO ĐÂY rồi kéo thả thẳng vào Timeline DaVinci Resolve, Premiere Pro, CapCut..."
                            PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDragTimeline}" Stroke="#E50914" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kéo vào Timeline" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13.5"/>
                            <TextBlock x:Name="DragModeBadge" Text="(Toàn bộ)" FontSize="12.5" Foreground="#B3B3B3" Margin="6,1,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 5. TAG MANAGEMENT & TAG SYNC FILE MODAL OVERLAY (MODERN STUDIO DARK DASHBOARD) -->
        <Grid x:Name="TagManageModal" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="4" Background="#D8060606" Panel.ZIndex="130">
            <Border Background="#151515" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="12"
                    Width="660" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.92" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0. Header Bar -->
                        <RowDefinition Height="*"/>    <!-- 1. Body Content -->
                        <RowDefinition Height="Auto"/> <!-- 2. Footer Bar -->
                    </Grid.RowDefinitions>

                    <!-- 0. Modal Header Bar -->
                    <Border Grid.Row="0" Background="#1B1B1B" BorderBrush="#262626" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="20,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="#132230" BorderBrush="#1F3B54" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconTag}" Stroke="#38BDF8" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="QUẢN LÝ TAG &amp; DỮ LIỆU ĐỒNG BỘ" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Quản lý danh sách Tag, tối ưu tốc độ nạp &amp; bảo vệ file sfx-settings-sync.json" FontSize="12" Foreground="#8E8E8E" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="✕" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" FontSize="14" Click="CloseTagManageModal_Click" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 1. Body Content -->
                    <Grid Grid.Row="1" Margin="20,16,20,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Tag Sync File Card -->
                            <RowDefinition Height="Auto"/> <!-- Section Label -->
                            <RowDefinition Height="Auto"/> <!-- Add New Tag Bar -->
                            <RowDefinition Height="*"/>    <!-- Scrollable Tag List -->
                        </Grid.RowDefinitions>

                        <!-- TAG FILE MANAGER CARD (Matte Carbon Dark) -->
                        <Border Grid.Row="0" Background="#1B1B1B" BorderBrush="#292929" BorderThickness="1" CornerRadius="10" Padding="15,13" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconDatabase}" Stroke="#38BDF8" Width="13" Height="13" Margin="0,0,7,0"/>
                                        <TextBlock Text="FILE DỮ LIỆU TAG &amp; CẤU TRÚC BIN (sfx-settings-sync.json)" FontSize="11.5" FontWeight="Bold" Foreground="#B3B3B3" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border HorizontalAlignment="Right" Background="#12261C" BorderBrush="#1F4632" BorderThickness="1" CornerRadius="5" Padding="8,2.5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#46D369" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TagFileStatsSummaryText"
                                                       Text="Đang kết nối..."
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#46D369"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Sleek Recessed Path Box -->
                                <Border Background="#111111" BorderBrush="#242424" BorderThickness="1" CornerRadius="6" Padding="11,7" Margin="0,0,0,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolder}" Stroke="#6E6E6E" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TagFileCurrentPathText"
                                                   Grid.Column="1"
                                                   Text="F:\Business Dropbox\Tran Vinh\Tài Nguyên Dựng Phim\DaVinci Resolve Studio\Z-Station_Studio\sfx-settings-sync.json"
                                                   FontSize="11.5"
                                                   Foreground="#D4D4D4"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </Grid>
                                </Border>

                                <!-- 4 Balanced Action Buttons on a Single Row -->
                                <UniformGrid Columns="4" Rows="1">
                                    <Button x:Name="SelectTagFileBtn"
                                            Height="32"
                                            Margin="0,0,4,0"
                                            Padding="8,0"
                                            FontSize="12"
                                            Background="#232323"
                                            BorderBrush="#333333"
                                            Foreground="#E5E5E5"
                                            ToolTip="Chọn hoặc liên kết tới file sfx-settings-sync.json trên máy tính của bạn"
                                            Click="SelectTagFileBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolderImport}" Stroke="#38BDF8" Width="12" Height="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Liên kết File" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OptimizeTagFileBtn"
                                            Height="32"
                                            Margin="4,0,4,0"
                                            Padding="8,0"
                                            FontSize="12"
                                            Background="#14281D"
                                            BorderBrush="#234B35"
                                            Foreground="#46D369"
                                            ToolTip="Tối ưu hóa file sfx-settings-sync.json và bộ nhớ đệm chỉ mục để mở phần mềm &amp; load Tag siêu tốc"
                                            Click="OptimizeTagFileBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconLightning}" Stroke="#46D369" Width="12" Height="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tối ưu Load" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BackupTagFileBtn"
                                            Height="32"
                                            Margin="4,0,4,0"
                                            Padding="8,0"
                                            FontSize="12"
                                            Background="#232323"
                                            BorderBrush="#333333"
                                            Foreground="#E5E5E5"
                                            ToolTip="Tạo bản sao lưu dự phòng (Backup) cho file Tag vào thư mục TagBackups"
                                            Click="BackupTagFileBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconCloud}" Stroke="#F59E0B" Width="12" Height="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Sao lưu" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OpenTagFileFolderBtn"
                                            Height="32"
                                            Margin="4,0,0,0"
                                            Padding="8,0"
                                            FontSize="12"
                                            Background="#232323"
                                            BorderBrush="#333333"
                                            Foreground="#B3B3B3"
                                            ToolTip="Mở thư mục chứa file sfx-settings-sync.json trong Windows Explorer"
                                            Click="OpenTagFileFolderBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconExternalLink}" Stroke="#9A9A9A" Width="12" Height="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Mở vị trí File" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Section Label -->
                        <Grid Grid.Row="1" Margin="2,0,2,8">
                            <TextBlock Text="DANH SÁCH TAG HIỆN CÓ" FontSize="11.5" FontWeight="Bold" Foreground="#8E8E8E" VerticalAlignment="Center"/>
                            <TextBlock Text="Sửa tên trực tiếp bên dưới rồi nhấn 'Lưu' (hoặc Enter)" FontSize="11.5" Foreground="#686868" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Add Tag Row -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#111111" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="7" Height="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconTag}" Stroke="#666666" Width="13" Height="13" Margin="12,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ModalNewTagInput"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#FFFFFF"
                                             CaretBrush="#E50914"
                                             FontSize="13.5"
                                             VerticalContentAlignment="Center"
                                             Padding="4,0,10,0"
                                             KeyDown="ModalNewTagInput_KeyDown"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Nhập tên Tag mới để thêm vào thư viện..."
                                               Foreground="#555555"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ModalNewTagInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Button x:Name="ModalAddTagBtn"
                                    Grid.Column="1"
                                    Height="36"
                                    Margin="8,0,0,0"
                                    Padding="18,0"
                                    Content="+ Thêm Tag"
                                    FontWeight="Bold"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ModalAddTagBtn_Click"/>
                        </Grid>

                        <!-- Scrollable Tag List -->
                        <ScrollViewer Grid.Row="3" MaxHeight="265" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="ModalTagListPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 2. Footer Bar -->
                    <Border Grid.Row="2" Background="#191919" BorderBrush="#252525" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,12">
                        <Grid>
                            <TextBlock Text="Mọi thay đổi Tag được tự động lưu vào file sfx-settings-sync.json" FontSize="12" Foreground="#6E6E6E" VerticalAlignment="Center"/>
                            <Button Content="Đóng" HorizontalAlignment="Right" Padding="24,6" Background="#262626" BorderBrush="#383838" Foreground="#FFFFFF" FontWeight="SemiBold" Click="CloseTagManageModal_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>


        <!-- 7. PICK BIN MODAL OVERLAY (To assign selected SFX into a Bin) -->
        <Grid x:Name="PickBinModal" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="4" Background="#D0000000">
            <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="8"
                    Width="480" MaxHeight="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="Auto"/> <!-- Description -->
                        <RowDefinition Height="*"/>    <!-- Bins List -->
                        <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolderPlus}" Stroke="#C59B27" Width="14" Height="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Chọn Bin Để Cho SFX Vào" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0" Foreground="#B3B3B3" Click="ClosePickBinModal_Click" Cursor="Hand"/>
                    </Grid>

                    <TextBlock x:Name="PickBinModalDesc" Grid.Row="1" Text="Chọn một thư mục Bin để gán các SFX đang chọn vào:" FontSize="13" Foreground="#8C8C8C" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="2" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <StackPanel x:Name="PickBinListPanel"/>
                    </ScrollViewer>

                    <Grid Grid.Row="3">
                        <Button Content="+ Tạo Bin mới" HorizontalAlignment="Left" Padding="12,5" Background="#262626" BorderBrush="#383838" Foreground="#FFFFFF" Click="PickBinModalCreateNew_Click"/>
                        <Button Content="Đóng" HorizontalAlignment="Right" Padding="16,5" Background="#262626" BorderBrush="#383838" Foreground="#B3B3B3" Click="ClosePickBinModal_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 8. BIN LINK & AUTO-SYNC MODAL OVERLAY -->
        <Grid x:Name="BinLinkModal" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="4" Background="#D0000000">
            <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="8"
                    Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconLink}" Stroke="#38BDF8" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="Liên kết Thư mục Ổ đĩa (Auto-Update)" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0" Foreground="#B3B3B3" Click="CloseBinLinkModal_Click" Cursor="Hand"/>
                    </Grid>

                    <TextBlock Text="Liên kết Bin với một thư mục trên ổ đĩa để tự động cập nhật khi có file nhạc / SFX mới được thêm vào."
                               FontSize="13" Foreground="#8C8C8C" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- Bin Name -->
                    <TextBlock Text="Tên Thư mục / Bin:" FontSize="12.5" FontWeight="SemiBold" Foreground="#B3B3B3" Margin="0,0,0,5"/>
                    <TextBox x:Name="BinLinkModalNameInput"
                             Height="32"
                             Padding="8,5"
                             Background="#141414"
                             Foreground="#FFFFFF"
                             CaretBrush="#E50914"
                             BorderBrush="#333333"
                             FontSize="13.5"
                             Margin="0,0,0,14">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Linked Folder Box -->
                    <Border Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconLink}" Stroke="#38BDF8" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Thư mục liên kết trên ổ đĩa (Auto-Sync):" FontSize="12.5" FontWeight="SemiBold" Foreground="#D4D4D4" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="ClearBinLinkPathBtn"
                                        Content="✕ Bỏ liên kết"
                                        HorizontalAlignment="Right"
                                        Padding="7,2"
                                        FontSize="12"
                                        Background="#221414"
                                        BorderBrush="#E50914"
                                        Foreground="#FF4D4D"
                                        Visibility="Collapsed"
                                        Click="ClearBinLinkPathBtn_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BinLinkModalPathInput"
                                         Grid.Column="0"
                                         Height="30"
                                         Padding="8,4"
                                         Background="#1C1C1C"
                                         Foreground="#E5E5E5"
                                         CaretBrush="#E50914"
                                         BorderBrush="#333333"
                                         FontSize="12.5"
                                         VerticalContentAlignment="Center"
                                         TextChanged="BinLinkModalPathInput_TextChanged">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <TextBlock x:Name="BinLinkModalPathPlaceholder"
                                           Grid.Column="0"
                                           Text="Chưa liên kết thư mục ổ đĩa..."
                                           Foreground="#666666"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           IsHitTestVisible="False"/>
                                <Button x:Name="BrowseBinLinkPathBtn"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="12,5"
                                        Content="📁 Chọn thư mục..."
                                        Click="BrowseBinLinkPathBtn_Click"/>
                            </Grid>

                            <CheckBox x:Name="BinLinkModalAutoSyncCheck"
                                      IsChecked="True"
                                      Content="Tự động đồng bộ file mới khi tải về hoặc thêm vào thư mục ổ đĩa"
                                      Foreground="#E5E5E5"
                                      FontSize="13"
                                      Margin="0,0,0,6"/>

                            <TextBlock Text="💡 Khi liên kết, bất kỳ bài nhạc / SFX mới nào thêm vào thư mục này trên ổ đĩa (hoặc Dropbox đồng bộ về) sẽ tự động cập nhật vào Bin mà không cần kéo thả tay."
                                       FontSize="12"
                                       Foreground="#737373"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer Actions -->
                    <Grid>
                        <Button x:Name="SyncNowFromModalBtn"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                Background="#262626"
                                BorderBrush="#383838"
                                Foreground="#46D369"
                                ToolTip="Quét thư mục liên kết và cập nhật ngay các file mới"
                                Click="SyncNowFromModalBtn_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconRefresh}" Stroke="#46D369" Width="12" Height="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Đồng bộ ngay" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy" Padding="16,6" Margin="0,0,8,0" Background="#262626" BorderBrush="#383838" Foreground="#B3B3B3" Click="CloseBinLinkModal_Click"/>
                            <Button x:Name="SaveBinLinkModalBtn" Content="Lưu thiết lập" Padding="18,6" Style="{StaticResource PrimaryButton}" Click="SaveBinLinkModalBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 9. CACHE MANAGER MODAL OVERLAY (MODERN STUDIO DASHBOARD) -->
        <Grid x:Name="CacheManageModal" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="4" Background="#D8060606">
            <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12"
                    Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.92" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 1. Modal Header Bar -->
                    <Border Background="#1B1B1B" BorderBrush="#262626" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Vector Icon Badge -->
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="#122636" BorderBrush="#1F425C" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconDatabase}" Stroke="#38BDF8" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Title & Subtitle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Quản lý Bộ nhớ đệm (Cache)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Border x:Name="CacheLocationBadge" Background="#122636" BorderBrush="#1F425C" BorderThickness="1" CornerRadius="4" Padding="7,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="CacheLocationBadgeText" Text="Mặc định" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Tăng tốc khởi động, chuyển Bin/Tag tức thì (0ms) và lưu sóng âm thông minh"
                                           FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Close Button -->
                            <Button Grid.Column="2" Width="30" Height="30" Padding="0" Background="#242424" BorderBrush="#333333" Foreground="#A3A3A3"
                                    VerticalAlignment="Center" Click="CloseCacheManageModal_Click" Cursor="Hand" ToolTip="Đóng">
                                <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 2. Modal Body -->
                    <StackPanel Margin="20,16,20,16">

                        <!-- HERO CARD: Total Storage + Segmented Visual Bar -->
                        <Border Background="#1C1C1C" BorderBrush="#292929" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="TỔNG DUNG LƯỢNG CACHE:" FontSize="11" FontWeight="Bold" Foreground="#7A7A7A" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CacheTotalSizeText" Text="0 KB" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Legend Dots -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Sóng âm" FontSize="11" Foreground="#9A9A9A" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#46D369" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Chỉ mục" FontSize="11" Foreground="#9A9A9A" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#C084FC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Video Preview" FontSize="11" Foreground="#9A9A9A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Segmented Multi-Color Bar -->
                                <Border Background="#111111" BorderBrush="#252525" BorderThickness="1" CornerRadius="4" Height="8" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="CacheWaveBarCol" Width="1*"/>
                                            <ColumnDefinition x:Name="CacheIndexBarCol" Width="1*"/>
                                            <ColumnDefinition x:Name="CacheVideoBarCol" Width="1*"/>
                                            <ColumnDefinition x:Name="CacheEmptyBarCol" Width="0*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#38BDF8" Margin="0,0,1,0"/>
                                        <Border Grid.Column="1" Background="#46D369" Margin="0,0,1,0"/>
                                        <Border Grid.Column="2" Background="#C084FC"/>
                                        <Border Grid.Column="3" Background="#161616"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- STORAGE LOCATION CARD -->
                        <Border Background="#1C1C1C" BorderBrush="#292929" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolder}" Stroke="#C59B27" Width="13" Height="13" Margin="0,0,7,0"/>
                                        <TextBlock Text="Địa chỉ lưu Cache trên ổ đĩa" FontSize="12.5" FontWeight="SemiBold" Foreground="#E5E5E5" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="OpenCacheDirBtn"
                                                Padding="9,3"
                                                FontSize="11.5"
                                                Margin="0,0,6,0"
                                                Background="#252525"
                                                BorderBrush="#363636"
                                                Foreground="#D4D4D4"
                                                Click="OpenCacheDirBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconExternalLink}" Width="11" Height="11" Margin="0,0,5,0"/>
                                                <TextBlock Text="Mở thư mục" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ResetDefaultCacheDirBtn"
                                                Padding="9,3"
                                                FontSize="11.5"
                                                Background="#241617"
                                                BorderBrush="#4A2024"
                                                Foreground="#FF6B6B"
                                                Visibility="Collapsed"
                                                Click="ResetDefaultCacheDirBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconRefresh}" Stroke="#FF6B6B" Width="11" Height="11" Margin="0,0,5,0"/>
                                                <TextBlock Text="Về mặc định" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Unified Path Input + Browse Action -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#121212" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6" Height="34">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolder}" Stroke="#737373" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBox x:Name="CacheDirPathInput"
                                                     Grid.Column="1"
                                                     IsReadOnly="True"
                                                     Background="Transparent"
                                                     Foreground="#E5E5E5"
                                                     BorderThickness="0"
                                                     Padding="0,0,8,0"
                                                     FontSize="12.5"
                                                     FontWeight="SemiBold"
                                                     VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Button x:Name="BrowseCacheDirBtn"
                                            Grid.Column="1"
                                            Height="34"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            Background="#262626"
                                            BorderBrush="#3D3D3D"
                                            Foreground="#FFFFFF"
                                            Click="BrowseCacheDirBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconFolderImport}" Stroke="#38BDF8" Width="13" Height="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="Chọn thư mục lưu..." FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Khi đổi địa chỉ lưu, toàn bộ dữ liệu Cache hiện có sẽ tự động được di chuyển sang thư mục mới."
                                           FontSize="11.5"
                                           Foreground="#6E6E6E"/>
                            </StackPanel>
                        </Border>

                        <!-- BENTO LAYER CARDS (4 LAYERS) -->
                        <!-- Layer 1: Waveform Cache -->
                        <Border Background="#1C1C1C" BorderBrush="#292929" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#122636" BorderBrush="#1E3F5A" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconAudioWave}" Stroke="#38BDF8" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Sóng âm thanh (Waveform Cache)" FontSize="13" Foreground="#F0F0F0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="2.4 KB / bài" FontSize="10.5" Foreground="#8C8C8C" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="CacheWaveformStatsText" Text="0 file đã lưu • 0 KB" FontSize="11.5" Foreground="#8A8A8A" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PrebuildWaveformBtn"
                                                Padding="10,4"
                                                FontSize="11.5"
                                                Margin="0,0,6,0"
                                                Background="#122636"
                                                BorderBrush="#0284C7"
                                                Foreground="#38BDF8"
                                                ToolTip="Quét và tạo trước sóng âm cho toàn bộ kho nhạc để bấm bài nào cũng hiện sóng ngay lập tức"
                                                Click="PrebuildWaveformBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconLightning}" Stroke="#38BDF8" Width="11" Height="11" Margin="0,0,5,0"/>
                                                <TextBlock Text="Tạo trước toàn bộ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="8,4"
                                                FontSize="11.5"
                                                Background="#242424"
                                                BorderBrush="#363636"
                                                Foreground="#A3A3A3"
                                                ToolTip="Xóa Cache sóng âm"
                                                Click="ClearWaveformCacheBtn_Click">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconTrash}" Width="12" Height="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Prebuild Progress Panel -->
                                <Border x:Name="CachePrebuildProgressPanel" Visibility="Collapsed" Background="#141414" BorderBrush="#282828" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock x:Name="CachePrebuildStatusText" Text="Đang tạo cache sóng âm..." FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
                                            <Button x:Name="CancelPrebuildWaveformBtn"
                                                    Content="Dừng"
                                                    HorizontalAlignment="Right"
                                                    Padding="8,2"
                                                    FontSize="11"
                                                    Background="#241617"
                                                    BorderBrush="#4A2024"
                                                    Foreground="#FF6B6B"
                                                    Click="CancelPrebuildWaveformBtn_Click"/>
                                        </Grid>
                                        <ProgressBar x:Name="CachePrebuildProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#38BDF8" Background="#262626" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Layer 2: Library Index Cache -->
                        <Border Background="#1C1C1C" BorderBrush="#292929" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#12291C" BorderBrush="#1E4630" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconDatabase}" Stroke="#46D369" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Chỉ mục Thư viện (Library Index Cache)" FontSize="13" Foreground="#F0F0F0" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CacheIndexStatsText" Text="0 mục • 0 KB" FontSize="11.5" Foreground="#8A8A8A" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Padding="10,4"
                                        FontSize="11.5"
                                        VerticalAlignment="Center"
                                        Background="#242424"
                                        BorderBrush="#363636"
                                        Foreground="#D4D4D4"
                                        Click="RebuildIndexCacheBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconRefresh}" Stroke="#46D369" Width="11" Height="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="Làm mới Index" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Layer 3: Video Thumbnail Cache -->
                        <Border Background="#1C1C1C" BorderBrush="#292929" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#231532" BorderBrush="#3E2459" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconVideo}" Stroke="#C084FC" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Khung hình Xem trước Video (Video Preview Cache)" FontSize="13" Foreground="#F0F0F0" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CacheVideoStatsText" Text="0 file • 0 KB" FontSize="11.5" Foreground="#8A8A8A" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Padding="8,4"
                                        FontSize="11.5"
                                        VerticalAlignment="Center"
                                        Background="#242424"
                                        BorderBrush="#363636"
                                        Foreground="#A3A3A3"
                                        ToolTip="Xóa Cache khung hình Video"
                                        Click="ClearVideoCacheBtn_Click">
                                    <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconTrash}" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Layer 4: RAM Filter Cache -->
                        <Border Background="#1C1C1C" BorderBrush="#292929" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2A1517" BorderBrush="#4C2226" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconCpu}" Stroke="#FF555E" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Bộ nhớ đệm Chuyển Thư mục &amp; Lọc Tag (RAM)" FontSize="13" Foreground="#F0F0F0" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CacheRamStatsText" Text="Đang hoạt động • Chuyển Bin &amp; Tag 0ms" FontSize="11.5" Foreground="#8A8A8A" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="#12291C" BorderBrush="#1E4630" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#46D369" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ACTIVE • 0ms" FontSize="10.5" FontWeight="Bold" Foreground="#46D369" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 3. Modal Footer Bar -->
                    <Border Background="#1B1B1B" BorderBrush="#262626" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,14">
                        <Grid>
                            <Button x:Name="ClearAllCacheBtn"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Background="#241617"
                                    BorderBrush="#4A2024"
                                    Foreground="#FF6B6B"
                                    Click="ClearAllCacheBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconTrash}" Stroke="#FF6B6B" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Xóa toàn bộ Cache" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Content="Đóng"
                                    HorizontalAlignment="Right"
                                    Padding="24,6"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="CloseCacheManageModal_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 8. IN-APP OTA UPDATE & ADMIN PUBLISH MODAL OVERLAY -->
        <Grid x:Name="UpdateManageModal"
              Grid.Row="0" Grid.RowSpan="4"
              Background="#CC000000"
              Visibility="Collapsed"
              Panel.ZIndex="135">
            <Border Width="620"
                    Background="#161616"
                    BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    CornerRadius="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.9"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 1. Modal Header -->
                    <Border Background="#1D1D1D" BorderBrush="#282828" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="#12291C" BorderBrush="#1E4630" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconCloud}" Stroke="#46D369" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="CẬP NHẬT PHIÊN BẢN (Z-STATION OTA UPDATE)" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                                <TextBlock Text="Cập nhật trực tiếp trong phần mềm — Giữ nguyên 100% Tag, Thư mục Bin &amp; Dữ liệu cá nhân" FontSize="12" Foreground="#9A9A9A" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#8C8C8C" FontSize="15" VerticalAlignment="Top" Click="CloseUpdateManageModal_Click"/>
                        </Grid>
                    </Border>

                    <!-- 2. Modal Body -->
                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16">
                            <!-- Current vs Latest Version Summary Card -->
                            <Border Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="PHIÊN BẢN HIỆN TẠI" FontSize="11" FontWeight="Bold" Foreground="#8A8A8A"/>
                                        <TextBlock x:Name="UpdateCurrentVersionText" Text="v1.2.0" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="➔" FontSize="18" Foreground="#555555" VerticalAlignment="Center" Margin="14,0"/>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="PHIÊN BẢN MỚI NHẤT" FontSize="11" FontWeight="Bold" Foreground="#8A8A8A"/>
                                        <TextBlock x:Name="UpdateLatestVersionText" Text="Đang kiểm tra..." FontSize="20" FontWeight="Bold" Foreground="#46D369" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            x:Name="CheckUpdateNowBtn"
                                            Padding="12,7"
                                            VerticalAlignment="Center"
                                            Background="#262626"
                                            BorderBrush="#3D3D3D"
                                            Foreground="#E5E5E5"
                                            Click="CheckUpdateNowBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconRefresh}" Stroke="#38BDF8" Width="12" Height="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Kiểm tra lại" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Status & Release Notes Box -->
                            <Border x:Name="UpdateStatusBanner" Background="#1A241E" BorderBrush="#264531" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="UpdateStatusHeadlineText" Text="Đang kiểm tra phiên bản mới..." FontSize="13.5" FontWeight="Bold" Foreground="#46D369"/>
                                    <TextBlock x:Name="UpdatePublishedTimeText" Text="" FontSize="11.5" Foreground="#9A9A9A" Margin="0,3,0,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="UpdateReleaseNotesText"
                                               Text="Nhấn 'Kiểm tra lại' để tìm bản cập nhật mới nhất."
                                               FontSize="12.5"
                                               Foreground="#D4D4D4"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Download / Install Progress Bar -->
                            <Border x:Name="UpdateProgressPanel" Visibility="Collapsed" Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="UpdateProgressStatusText" Text="Đang tải bản cập nhật..." FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                    <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#E50914" Background="#262626" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Action Button: Apply Update & Auto-Reload -->
                            <Button x:Name="ApplyUpdateNowBtn"
                                    Visibility="Collapsed"
                                    Padding="16,11"
                                    Margin="0,0,0,14"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ApplyUpdateNowBtn_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideStrokeIcon}" Data="{StaticResource IconLightning}" Stroke="#FFFFFF" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ApplyUpdateNowBtnText" Text="CẬP NHẬT NGAY &amp; TỰ ĐỘNG KHỞI ĐỘNG LẠI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Admin / Creator Publish Expander -->
                            <Expander x:Name="AdminPublishExpander"
                                      Header="⚙️ Phát hành bản mới &amp; Cấu hình Nguồn Cập nhật (Dành cho bạn / Admin)"
                                      Foreground="#B3B3B3"
                                      FontSize="12.5"
                                      FontWeight="SemiBold"
                                      IsExpanded="False"
                                      Margin="0,4,0,0">
                                <Border Background="#1B1B1B" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Mỗi khi bạn chỉnh sửa hoặc nâng cấp app trên máy này, bấm nút bên dưới để đóng gói phiên bản mới. Những người dùng khác khi bấm 'Kiểm tra cập nhật' sẽ nhận được thông báo và tự động cập nhật ngay."
                                                   FontSize="11.5"
                                                   Foreground="#9A9A9A"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Số phiên bản mới:" FontSize="12" Foreground="#D4D4D4" VerticalAlignment="Center"/>
                                            <TextBox x:Name="PublishVersionInput"
                                                     Grid.Column="1"
                                                     Text="1.2.1"
                                                     Background="#121212"
                                                     Foreground="#FFFFFF"
                                                     CaretBrush="#E50914"
                                                     BorderBrush="#333333"
                                                     Padding="8,5"
                                                     FontSize="12.5"
                                                     FontWeight="Bold"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Nội dung cập nhật:" FontSize="12" Foreground="#D4D4D4" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <TextBox x:Name="PublishNotesInput"
                                                     Grid.Column="1"
                                                     Text="• Thiết kế Sidebar Tag Nhanh (Inspector) cạnh phải với phím tắt Ctrl + T&#x0a;• Font chữ to rõ (>= 12.5px), pill bo góc và màu sắc tương phản cao Modern Studio Dark&#x0a;• Tối ưu thanh lọc multi-tag phía trên, gán và lọc tag tức thì không cần chuyển chế độ"
                                                     Height="68"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Background="#121212"
                                                     Foreground="#FFFFFF"
                                                     CaretBrush="#E50914"
                                                     BorderBrush="#333333"
                                                     Padding="8,5"
                                                     FontSize="12"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Link Cloud version.json:" FontSize="11.5" Foreground="#9A9A9A" VerticalAlignment="Center" ToolTip="Dán link chia sẻ Dropbox của file Updates/version.json (tùy chọn nếu cập nhật qua Internet ngoài công ty)"/>
                                            <TextBox x:Name="PublishManifestUrlInput"
                                                     Grid.Column="1"
                                                     Background="#121212"
                                                     Foreground="#CCCCCC"
                                                     CaretBrush="#E50914"
                                                     BorderBrush="#333333"
                                                     Padding="8,4"
                                                     FontSize="11.5"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Link Cloud gói Update.zip:" FontSize="11.5" Foreground="#9A9A9A" VerticalAlignment="Center" ToolTip="Dán link chia sẻ Dropbox của file Updates/Z-Station_Studio_Update.zip (tùy chọn nếu cập nhật qua Internet ngoài công ty)"/>
                                            <TextBox x:Name="PublishPackageUrlInput"
                                                     Grid.Column="1"
                                                     Background="#121212"
                                                     Foreground="#CCCCCC"
                                                     CaretBrush="#E50914"
                                                     BorderBrush="#333333"
                                                     Padding="8,4"
                                                     FontSize="11.5"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    x:Name="OpenUpdatesFolderBtn"
                                                    Content="📂 Mở thư mục Updates"
                                                    Padding="10,6"
                                                    FontSize="12"
                                                    Background="#242424"
                                                    BorderBrush="#383838"
                                                    Foreground="#D4D4D4"
                                                    Click="OpenUpdatesFolderBtn_Click"/>

                                            <Button Grid.Column="2"
                                                    x:Name="PublishUpdateBtn"
                                                    Content="📦 Đóng gói &amp; Phát hành bản mới"
                                                    Padding="14,6"
                                                    FontSize="12.5"
                                                    FontWeight="Bold"
                                                    Background="#122636"
                                                    BorderBrush="#0284C7"
                                                    Foreground="#38BDF8"
                                                    Click="PublishUpdateBtn_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. Modal Footer Bar -->
                    <Border Background="#1B1B1B" BorderBrush="#262626" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,12">
                        <Grid>
                            <TextBlock x:Name="UpdateSourceFooterText" Text="Nguồn cập nhật: Tự động đồng bộ Z-Station Studio" FontSize="11.5" Foreground="#737373" VerticalAlignment="Center"/>
                            <Button Content="Đóng"
                                    HorizontalAlignment="Right"
                                    Padding="24,6"
                                    Background="#262626"
                                    BorderBrush="#383838"
                                    Foreground="#FFFFFF"
                                    Click="CloseUpdateManageModal_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
